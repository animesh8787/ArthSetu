# Copy to backend/.env and adjust as needed.

APP_NAME=ArthSetu
APP_VERSION=1.0.0
APP_ENV=development
API_V1_PREFIX=/api/v1

# Local dev default is portable SQLite. For Postgres use e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/arthsetu
DATABASE_URL=sqlite:///./arthsetu_dev.db

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth (Firebase) --------------------------------------------------
# Local dev: leave FIREBASE_CREDENTIALS_JSON unset and run the Firebase
# Auth Emulator instead (`firebase emulators:start --only auth`), then set
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 (host.docker.internal:9099 inside
# Docker) - the backend exports it for token verification and Admin SDK calls.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_PROJECT_ID=arthsetu-dev
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", ...}

BOOTSTRAP_ADMIN_EMAIL=admin@arthsetu.local
BOOTSTRAP_ADMIN_PASSWORD=arthsetu-admin
