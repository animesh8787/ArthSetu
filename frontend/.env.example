# Dev: leave unset — Vite proxies /api to http://localhost:8000 (see vite.config.ts).
# Prod: point this at the deployed API origin + prefix.
# VITE_API_BASE_URL=https://api.arthsetu.example/api/v1

# Optional: override the dev proxy target.
# VITE_API_TARGET=http://localhost:8000

# --- Auth (Firebase) --------------------------------------------------
# Web app config from the Firebase console (Project settings > Your apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local dev: point at the Firebase Auth Emulator (matches the backend's
# FIREBASE_AUTH_EMULATOR_HOST) so sign-in works without a real project.
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
