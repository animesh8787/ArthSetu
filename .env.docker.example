# Copy to .env (repo root) before `docker compose up` for a real deployment.
# Left unset, docker-compose.yml falls back to insecure defaults suitable
# only for a local trial run — see docker-compose.yml.

# APP_ENV=production makes the backend refuse to start unless
# FIREBASE_CREDENTIALS_JSON and BOOTSTRAP_ADMIN_PASSWORD below are also
# overridden (backend/app/core/config.py).
APP_ENV=production

# Paste the full contents of a Firebase service-account JSON (Project
# settings > Service accounts > Generate new private key) as one line.
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=

# Web app config from the Firebase console (Project settings > Your apps).
# The frontend image bakes these in at build time - rebuild after changing them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Local trial with the Auth Emulator instead of a real project:
# FIREBASE_AUTH_EMULATOR_HOST=host.docker.internal:9099   (backend container)
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099         (your browser)

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

POSTGRES_USER=arthsetu
POSTGRES_PASSWORD=
POSTGRES_DB=arthsetu

# Browser origins allowed to call the API (comma-separated). Set this to
# your real frontend origin(s) in production.
CORS_ORIGINS=http://localhost:8080

# uvicorn worker processes in the backend container.
WEB_CONCURRENCY=2
